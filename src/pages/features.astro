---
import Base from "../layouts/Base.astro";
import StoreBadge from "../components/StoreBadge.astro";
import Lottie from "../components/Lottie.astro";
---

<Base
  title="Features"
  description="UTG features: 3 free follows, Pro+ unlimited, price Buy or Wait, iCloud collections, limited AI, Epic/Game Pass/giveaways, widgets, Watch, weather and nearby play."
  path="/features"
  current="/features"
>
  <div class="wrap page-hero">
    <img class="hero-icon" src="/assets/app-icon-128.png" width="56" height="56" alt="UTG app icon" />
    <p class="kicker">Features</p>
    <h1>One list. Honest limits.</h1>
    <p>Pick games you care about, get dates and alerts in one place. Free users follow three. Pro+ is there if the list grows — billed by Apple, not by a card form on this site.</p>
    <div class="hero-actions">
      <StoreBadge />
      <a class="btn btn-ghost" href="#how-it-works">How it works</a>
    </div>
  </div>

  <section class="wrap section" id="how-it-works">
    <p class="kicker">Loop</p>
    <h2>How it works</h2>
    <div class="loop">
      <article>
        <Lottie src="/lottie/browse.lottie" />
        <h3>Browse IGDB</h3>
        <p>Discover games from IGDB. Open a title for the date and platforms — not another tab of screenshots you will not reopen.</p>
      </article>
      <article>
        <Lottie src="/lottie/follow.lottie" />
        <h3>Follow / favorite</h3>
        <p>Follow or favorite what you intend to play. Free: <strong>3 follows</strong>. Pro+: unlimited. Collections sync with iCloud.</p>
      </article>
      <article>
        <Lottie src="/lottie/notify.lottie" />
        <h3>Get notified</h3>
        <p>Release reminders for games you follow, if you allow notifications. Off in iOS Settings → Notifications → UTG.</p>
      </article>
    </div>
  </section>

  <section class="wrap section">
    <p class="kicker">Features</p>
    <h2>What ships — and what is gated</h2>
    <p class="intro">If a tool is Pro+, it says so. We do not list vaporware here.</p>

    <div class="feature-block">
      <div>
        <p class="limit">IGDB catalog</p>
        <h3>Browse and search</h3>
        <p>Discover games from IGDB. Filter by platform, open a title for the date — not another tab of screenshots you will not reopen.</p>
      </div>
      <figure class="shot">
        <img src="/assets/search.png" width="390" height="844" alt="UTG search with Coming soon and Trending on IGDB" loading="lazy" decoding="async" />
      </figure>
    </div>

    <div class="feature-block reverse">
      <div>
        <p class="limit">Free: 3 follows · Pro+: unlimited</p>
        <h3>Upcoming releases</h3>
        <p>Track upcoming (and out-now) dates for games you follow. The free watchlist is three titles on purpose — enough for a personal release plan, small enough that alerts stay useful. UTG Pro+ lifts the follow limit when you want a longer list.</p>
      </div>
      <figure class="shot">
        <img src="/assets/game.png" width="390" height="844" alt="Game page with live context, rating, and release date" loading="lazy" decoding="async" />
      </figure>
    </div>

    <div class="feature-block">
      <div>
        <p class="limit">On-device + iCloud</p>
        <h3>Favorites and collections</h3>
        <p>Favorites and collections sync with iCloud on the Apple ID signed into the device. We do not sell your game list and we do not share it for advertising. See the <a href="/privacy">Privacy Policy</a>.</p>
      </div>
      <figure class="shot">
        <img src="/assets/favorites.png" width="390" height="844" alt="Favorites list in UTG with Counter-Strike 2 and Wardogs" loading="lazy" decoding="async" />
      </figure>
    </div>

    <div class="feature-block reverse">
      <div>
        <p class="limit">Pro+ for full price tools</p>
        <h3>Price tracking / Buy or Wait</h3>
        <p>Compare a current listing with historical-low context so you can wait or buy with less guesswork. Full price tools are UTG Pro+. Verdicts are informational, not financial advice. UTG is not a storefront. <strong>We do not store payment cards</strong> — Apple In-App Purchase handles Pro+ billing.</p>
      </div>
      <figure class="shot">
        <img src="/assets/price.png" width="390" height="844" alt="Buy or Wait with historical low versus current Steam price" loading="lazy" decoding="async" />
      </figure>
    </div>

    <div class="feature-block">
      <div>
        <p class="limit">Included</p>
        <h3>Free &amp; included catalogs</h3>
        <p>Epic free promotions, Game Pass listings, and giveaways in one scan. Availability is set by those stores and by region. Confirm on the official store before you claim anything.</p>
      </div>
      <figure class="shot">
        <img src="/assets/catalog.png" width="390" height="720" alt="Games list with Out this month and Epic Free promotions" loading="lazy" decoding="async" />
      </figure>
    </div>

    <div class="feature-block reverse">
      <div>
        <p class="limit">Limited free tries · then Pro+</p>
        <h3>AI game advisor + chat</h3>
        <p>Ask for a recommendation, a “what should I play,” or a second look at a title. Free users get limited tries; after that, UTG Pro+. Prompts go through our backend to OpenAI. Do not include passwords or personal data. The model can be wrong — check the catalog date before you rearrange your week.</p>
      </div>
      <figure class="shot">
        <img src="/assets/ai.png" width="390" height="844" alt="Game Assistant chat recommending titles similar to Call of Duty" loading="lazy" decoding="async" />
      </figure>
    </div>

    <div class="feature-block">
      <div>
        <p class="limit">Optional · When In Use</p>
        <h3>Weather and nearby play</h3>
        <p>When-in-use location only, if you allow it: city weather and nearby game stores on the map. Not used for ads. Not required for follows, catalog, or AI. Deny location and the rest of the app still works.</p>
      </div>
      <figure class="shot">
        <img src="/assets/weather.png" width="390" height="512" alt="UTG weather for London showing current temperature and conditions" loading="lazy" decoding="async" />
      </figure>
    </div>

    <div class="feature-block reverse">
      <div>
        <p class="limit">Home Screen + Watch</p>
        <h3>Widgets and complications</h3>
        <p>Widgets and Apple Watch complications countdown the next followed release. They show data you already follow in the app.</p>
      </div>
      <figure class="shot">
        <img src="/assets/widgets.png" width="390" height="844" alt="Home Screen widgets for the next UTG followed release" loading="lazy" decoding="async" />
      </figure>
    </div>

    <div class="grid grid-2">
      <article class="card">
        <p class="meta">Account</p>
        <h3>Optional account</h3>
        <p>Sign in with Apple, Google, or Firebase if you want. Skippable in onboarding. You can use the app without creating an account.</p>
      </article>
      <article class="card">
        <p class="meta">Not a store</p>
        <h3>Confirm before you buy or claim</h3>
        <p>UTG does not sell games. Catalog dates, prices, and AI answers can be wrong. Check the official store before you rearrange your week.</p>
      </article>
    </div>
  </section>

  <section class="wrap section">
    <div class="cta-band">
      <div>
        <h2>Pro+ is extra runway, not a lock on the door</h2>
        <p>Stay free with three follows and limited AI. Upgrade when you want unlimited follows, full price tools, and more advisor/chat. Apple bills it. Cancel in iOS Subscriptions.</p>
      </div>
      <a class="btn btn-primary" href="/pricing">See pricing</a>
    </div>
  </section>
</Base>
