---
import { SITE } from "../config";
import StoreBadge from "./StoreBadge.astro";
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <a class="logo" href="/">
        <img class="logo-mark" src="/assets/app-icon-128.webp" width="36" height="36" alt="" />
        <span class="logo-text"><strong>UTG</strong><span>Up To Game Pro</span></span>
      </a>
      <p class="fine">An iOS game companion. Discover, follow, get notified.</p>
      <StoreBadge source="footer" />
    </div>
    <div>
      <h2>App</h2>
      <ul>
        <li><a href="/features">Features</a></li>
        <li><a href="/pricing">Pricing</a></li>
        <li><a href="/download">Download</a></li>
        <li><a href="/ar/download" lang="ar">العربية</a></li>
        <li><a href="/universal-links">Universal Links</a></li>
        <li><a href="/press">Press</a></li>
        <li><a href="/status">Status</a></li>
      </ul>
    </div>
    <div>
      <h2>Legal</h2>
      <ul>
        <li><a href="/privacy">Privacy Policy</a></li>
        <li><a href="/terms">Terms of Use (EULA)</a></li>
        <li><a href="/subscription">Subscription Terms</a></li>
        <li><a href="/support">Support</a></li>
        <li><a href="/delete-account">Delete account</a></li>
        <li><a href="/cookies">Cookies</a></li>
        <li><a href="/accessibility">Accessibility</a></li>
        <li><a href="/security">Security</a></li>
      </ul>
    </div>
    <div>
      <h2>Contact</h2>
      <p><a class="mail" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      <p class="fine">{SITE.legalName}<br />{SITE.country} 🇸🇦</p>
    </div>
  </div>
  <div class="wrap legal-bar">
    <span>© {SITE.year} {SITE.legalName}. {SITE.name}.</span>
    <span>iOS 18+. App Store ID {SITE.appId}.</span>
  </div>
</footer>
