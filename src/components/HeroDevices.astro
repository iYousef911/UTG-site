---
import Phone from "./Phone.astro";
---

<div class="device-stage">
  <Phone
    variant="a"
    src="/assets/search.png"
    alt="UTG search with Coming soon and Trending on IGDB"
    caption="Browse"
  />
  <Phone
    variant="b"
    src="/assets/widgets.png"
    alt="UTG Home Screen widgets showing the next followed release"
    caption="Widgets"
  />
  <Phone
    variant="c"
    src="/assets/game.png"
    alt="UTG game page for Counter-Strike 2 with live context and release date"
    caption="Game page"
    loading="eager"
    fetchpriority="high"
  />
</div>
