---
import Phone from "./Phone.astro";
---

<div class="device-stage">
  <Phone
    variant="a"
    src="/assets/hero-watchlist.png"
    alt="UTG collections and followed games on iPhone"
    caption="Watchlist"
    loading="lazy"
  />
  <Phone
    variant="b"
    src="/assets/hero-widgets.png"
    alt="Placeholder for a UTG Home Screen widget screenshot. Replace assets/hero-widgets.png with a real capture."
    caption="Widgets"
    placeholder="assets/hero-widgets.png"
    loading="eager"
    fetchpriority="high"
  />
  <Phone
    variant="c"
    src="/assets/hero-countdown.png"
    alt="UTG game page showing a release date and alert controls"
    caption="Countdown"
    loading="lazy"
  />
</div>
