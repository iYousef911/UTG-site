---
import Phone from "./Phone.astro";
import UpcomingWidget from "./UpcomingWidget.astro";
---

<div class="device-stage">
  <Phone variant="a" caption="Widget">
    <UpcomingWidget />
  </Phone>
  <Phone
    variant="b"
    src="/assets/catalog.png"
    alt="UTG Games list with Out this month dates for three titles"
    caption="This month"
    loading="eager"
    fetchpriority="high"
  />
  <Phone
    variant="c"
    src="/assets/hero-countdown.png"
    alt="Call of Duty: Modern Warfare 4 in UTG, release date 16 Oct 2026"
    caption="Countdown"
  />
</div>
