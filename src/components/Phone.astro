---
interface Props {
  src?: string;
  alt?: string;
  caption: string;
  variant: "a" | "b" | "c";
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
}

const { src, alt = "", caption, variant, loading = "lazy", fetchpriority = "auto" } = Astro.props;
---

<figure class:list={["phone", `phone-${variant}`]}>
  <div class="phone-screen">
    <slot>
      {
        src && (
          <img
            src={src}
            width="390"
            height="844"
            alt={alt}
            loading={loading}
            decoding="async"
            fetchpriority={fetchpriority}
          />
        )
      }
    </slot>
  </div>
  <figcaption>{caption}</figcaption>
</figure>
