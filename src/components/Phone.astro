---
import Shot from "./Shot.astro";

interface Props {
  src?: string;
  alt?: string;
  caption: string;
  variant: "a" | "b" | "c";
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
}

const { src, alt = "", caption, variant, loading = "lazy", fetchpriority = "auto" } = Astro.props;
---

<figure class:list={["phone", `phone-${variant}`]}>
  <div class="phone-screen">
    <slot>
      {
        src && (
          <Shot src={src} alt={alt} loading={loading} fetchpriority={fetchpriority} />
        )
      }
    </slot>
  </div>
  <figcaption>{caption}</figcaption>
</figure>
