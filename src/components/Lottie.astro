---
interface Props {
  src: string;
  size?: "xs" | "sm" | "md" | "lg";
}

const { src, size = "sm" } = Astro.props;
---

<dotlottie-wc
  class:list={["lottie", `lottie-${size}`]}
  src={src}
  loop
  autoplay
  data-utg-lottie
  aria-hidden="true"
></dotlottie-wc>

<script>
  import "@lottiefiles/dotlottie-wc";

  type Player = {
    play: () => void;
    pause: () => void;
    setFrame?: (frame: number) => void;
  };
  type LottieEl = HTMLElement & { dotLottie?: Player | null };

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function wire(el: LottieEl) {
    const freeze = () => {
      const player = el.dotLottie;
      if (!player) return;
      player.pause();
      player.setFrame?.(0);
    };

    el.addEventListener("load", () => {
      if (reduce) freeze();
    });

    if (reduce) {
      freeze();
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        const player = el.dotLottie;
        if (!player) return;
        for (const entry of entries) {
          if (entry.isIntersecting) player.play();
          else player.pause();
        }
      },
      { threshold: 0.2 }
    );
    io.observe(el);
  }

  document.querySelectorAll<LottieEl>("[data-utg-lottie]").forEach(wire);
</script>
