---
import { NAV } from "../config";

interface Props {
  current?: string;
}

const { current } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isAr = path.startsWith("/ar");
const items = isAr
  ? [
      { href: "/ar/download", label: "تحميل" },
      { href: "/ar/support", label: "الدعم" },
      { href: "/", label: "English" },
    ]
  : [...NAV];
---

<header class="site-header">
  <div class="header-inner">
    <a class="logo" href={isAr ? "/ar/download" : "/"} aria-current={path === "/" || path === "/ar/download" ? "page" : undefined}>
      <img class="logo-mark" src="/assets/app-icon-128.webp" width="36" height="36" alt="" />
      <span class="logo-text"><strong>UTG</strong><span>Up To Game Pro</span></span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label={isAr ? "فتح القائمة" : "Open menu"}>
      <span></span>
    </button>
    <nav class="nav" id="site-nav">
      {
        items.map((item) => (
          <a href={item.href} aria-current={current === item.href || path === item.href ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
      {
        isAr ? (
          <a class="btn btn-primary" href="/ar/download" aria-current={path === "/ar/download" ? "page" : undefined}>
            حمّل التطبيق
          </a>
        ) : (
          <a class="btn btn-primary" href="/download" aria-current={path === "/download" ? "page" : undefined}>
            Get the app
          </a>
        )
      }
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector(".nav-toggle");
  const nav = document.querySelector("#site-nav");
  if (toggle instanceof HTMLButtonElement && nav instanceof HTMLElement) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle("is-open", open);
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      const ar = document.documentElement.lang === "ar";
      toggle.setAttribute("aria-label", open ? (ar ? "إغلاق القائمة" : "Close menu") : ar ? "فتح القائمة" : "Open menu");
    };
    toggle.addEventListener("click", () => setOpen(!nav.classList.contains("is-open")));
    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });
  }
</script>
