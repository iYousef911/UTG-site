# Hostinger / Apache. Upload the contents of dist/ to public_html.
DirectoryIndex index.html
AddDefaultCharset UTF-8
Options -Indexes -MultiViews

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Apple fetches AASA over HTTPS and does not follow redirects.
  # Internal rewrite to .json so Content-Type is application/json (HTTP 200, no Location).
  RewriteRule ^\.well-known/apple-app-site-association$ /.well-known/apple-app-site-association.json [L]
  RewriteRule ^apple-app-site-association$ /.well-known/apple-app-site-association.json [L]

  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.utg\.yadev\.tech$ [NC]
  RewriteRule ^ https://utg.yadev.tech%{REQUEST_URI} [R=301,L]

  # Old filename kept as a 301 so bookmarks still work
  RewriteRule ^subscriptions\.html$ /subscription [R=301,L]
  RewriteRule ^subscriptions$ /subscription [R=301,L]

  # Universal Link fallbacks: keep the public URL, no 301
  RewriteCond %{DOCUMENT_ROOT}/game/$1.html !-f
  RewriteRule ^game/([0-9]+)/?$ /game.html [L]
  RewriteCond %{DOCUMENT_ROOT}/news/$1.html !-f
  RewriteRule ^news/([0-9]+)/?$ /news.html [L]
  RewriteCond %{DOCUMENT_ROOT}/deals/$1.html !-f
  RewriteRule ^deals/([0-9]+)/?$ /deals.html [L]

  # Clean URLs: /privacy → privacy.html (App Store .html links still 200)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType image/vnd.microsoft.icon .ico
  AddType image/png .png
  AddType font/woff2 .woff2
</IfModule>

<Files "apple-app-site-association">
  <IfModule mod_mime.c>
    ForceType application/json
  </IfModule>
  <IfModule mod_headers.c>
    Header set Content-Type "application/json"
    Header set X-Content-Type-Options "nosniff"
    Header set Cache-Control "public, max-age=3600"
  </IfModule>
</Files>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json application/xml text/xml image/svg+xml font/woff2
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 14 days"
  ExpiresByType font/woff2 "access plus 30 days"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
