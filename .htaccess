# Hostinger / Apache (shared hosting or Apache VPS)
# After find-replace: utg.yadev.tech = apex host only, e.g. utg.app (no https://, no www)

DirectoryIndex index.html
AddDefaultCharset UTF-8
Options -Indexes

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS + apex (non-www). Enable SSL in hPanel first.
  # If you prefer www as canonical, see the block at the bottom.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.utg.yadev.tech$ [NC]
  RewriteRule ^ https://utg.yadev.tech%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/xml text/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# www-as-canonical alternative (do not use both). Comment out the apex block above, then:
# RewriteCond %{HTTPS} !=on [OR]
# RewriteCond %{HTTP_HOST} ^utg.yadev.tech$ [NC]
# RewriteRule ^ https://www.utg.yadev.tech%{REQUEST_URI} [R=301,L]
